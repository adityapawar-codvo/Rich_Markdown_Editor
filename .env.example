# AI editing agent (OpenRouter, OpenAI-compatible API). The key is read only from the environment.
# Never commit a real key. Leave empty to disable the agent.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Demo app
PORT=8080
CONTEXT_EDITOR_DB=context_editor_demo.db
NICEGUI_STORAGE_SECRET=change-me
